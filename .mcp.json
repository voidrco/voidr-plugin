{
  "mcpServers": {
    "voidr": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/voidr-mcp-bridge.mjs"
      ],
      "env": {
        "NODE_USE_ENV_PROXY": "1",
        "VOIDR_PLATFORM_URL": "https://platform.voidr.co",
        "VOIDR_AUTH_CALLBACK_URL": "https://platform.voidr.co/auth/cli-connect",
        "VOIDR_API_URL": "https://api.voidr.co/v1",
        "VOIDR_MCP_URL": "https://api.voidr.co/v1/mcp",
        "VOIDR_MCP_ORIGIN": "https://platform.voidr.co",
        "VOIDR_TOKEN_URL": "https://api.voidr.co/v1/service-accounts/token"
      },
      "tools": [
        "voidr_environment_doctor",
        "voidr_auth_status",
        "voidr_auth_select_organization",
        "voidr_auth_login",
        "voidr_workspace_inspect",
        "voidr_workspace_git_context",
        "voidr_workspace_bootstrap_test_repository",
        "voidr_workspace_select_test_repository",
        "voidr_workspace_prepare_test_repository",
        "voidr_context_refresh",
        "voidr_context_bootstrap",
        "voidr_workspace_scaffold_test_cases",
        "voidr_build",
        "voidr_explore",
        "voidr_release_deploy_validation",
        "voidr_create_validation_execution",
        "voidr_release_inspect",
        "voidr_workspace_publish_tests",
        "voidr_release_deploy_live",
        "voidr_repository_sync_github",
        "applications_list_applications",
        "applications_get_application",
        "applications_list_environments",
        "test_plans_get_test_counts",
        "test_plans_list_test_plans",
        "test_plans_get_test_plan",
        "test_plans_create_test_plan",
        "test_plans_update_test_plan",
        "test_plans_populate_test_plan",
        "test_plans_provision_repository",
        "test_plans_create_module",
        "test_plans_update_module",
        "test_plans_create_suite",
        "test_plans_update_suite",
        "test_plans_list_modules",
        "test_plans_get_module",
        "test_plans_list_suites",
        "test_plans_get_suite",
        "test_plans_list_cases",
        "test_plans_get_case",
        "test_plans_create_case",
        "test_plans_update_case",
        "test_plans_get_tag_history",
        "test_plans_update_test_case_tag",
        "test_plans_sync_repository_diff",
        "sessions_list_sessions",
        "sessions_get_session_actions",
        "sessions_get_session_action_effects",
        "sessions_get_session_digest",
        "sessions_get_session_summary",
        "sessions_get_session_screenmap",
        "sessions_get_session_selectors",
        "executions_list_executions",
        "executions_create_execution",
        "executions_get_execution",
        "executions_cancel_execution",
        "playwright_get_execution_analytics",
        "playwright_list_executions",
        "playwright_list_test_results",
        "playwright_list_execution_failures",
        "playwright_get_test_timeline",
        "playwright_get_test_history",
        "playwright_get_test_dom",
        "playwright_get_trace_events",
        "playwright_get_step_timeline",
        "playwright_get_step_frames",
        "assistant_context_get_step_detail",
        "failure_analysis_get_context",
        "file_embeddings_search_documents",
        "defects_list_defects",
        "defects_get_defect",
        "issue_tracker_list",
        "issue_tracker_list_projects",
        "defects_create_defect",
        "defects_create_defect_with_issue",
        "defects_update_defect",
        "defects_update_defect_status",
        "defects_assign_defect"
      ],
      "timeout": 360000,
      "disableToolCache": true
    }
  }
}
